# School Management System — Environment Template
# 1. Copy this file to .env and fill in your values.
# 2. Each installation MUST have its own unique SECRET_KEY.
#    Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# 3. For local development overrides (e.g. LICENSE_DEV=1), create .env.local
#    instead of editing this file — .env.local is loaded on top of .env.

# ── Core ────────────────────────────────────────────────────────────────────
# REQUIRED: generate a unique key for every installation — never reuse across machines
SECRET_KEY=replace-with-a-random-64-char-hex-string
DATABASE_URL=sqlite:///school.db
HOST=0.0.0.0
PORT=5000
# Set to 1 when serving over HTTPS — marks session cookie as Secure
COOKIE_SECURE=0
# Rate-limit storage: leave empty for single-worker dev (memory).
# Set to redis://redis:6379 when running multi-worker (Docker/Gunicorn).
# RATELIMIT_STORAGE_URI=redis://redis:6379

# ── QuickBooks Web Connector ─────────────────────────────────────────────────
QBWC_USER=qbadmin
QBWC_PASS=change-this-password

# ── Email / SMTP (for sending invoices to parents) ───────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-school-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=School Name <your-school-email@gmail.com>

# ── Monitoring ───────────────────────────────────────────────────────────────
# Get your free DSN at https://sentry.io → New Project → Python → Flask
# Leave blank to disable Sentry (errors still go to server.log).
SENTRY_DSN=
# Fraction of requests to trace for performance (0.0–1.0). 0.1 = 10%.
SENTRY_TRACES_RATE=0.1
# Flask environment tag shown in Sentry dashboard.
FLASK_ENV=production
# Directory for rotating log file. Defaults to project root.
# LOG_DIR=/var/log/schoolms

# ── Production overrides ─────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost/schooldb
# SECRET_KEY=generate-a-new-one-for-production
# HOST=0.0.0.0
# PORT=8000
